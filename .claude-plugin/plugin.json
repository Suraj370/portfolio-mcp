{
  "name": "portfolio",
  "version": "0.1.1",
  "description": "Edit Suraj's portfolio (projects, experience, skills, contact) from any Claude Code session. Changes are previewed, then committed to GitHub.",
  "author": {
    "name": "Suraj Panda"
  },
  "repository": "https://github.com/Suraj370/portfolio-mcp",
  "license": "MIT",
  "skills": [
    "./skills/"
  ],
  "commands": {
    "add-project": {
      "source": "./commands/add-project.md"
    },
    "add-role": {
      "source": "./commands/add-role.md"
    },
    "show": {
      "source": "./commands/show.md"
    }
  },
  "mcpServers": {
    "portfolio": {
      "command": "npx",
      "args": [
        "-y",
        "github:Suraj370/portfolio-mcp"
      ],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}",
        "PORTFOLIO_REPO": "Suraj370/surajpanda"
      }
    }
  }
}
